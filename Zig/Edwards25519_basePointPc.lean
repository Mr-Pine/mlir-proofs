/-- `is_base`: set at `1` alone. -/
def Edwards25519.basePointPc.isBase (i : Fin 16) : BitVec 1 :=
  if i.val = 1 then 1 else 0

end

/-- The table is 16 points of 168 bytes. -/
public theorem width_basePointPc : Edwards25519_basePointPc.t.width = 21504 := by decide

/-- For `decide +kernel` on the table's literal. -/
instance : DecidableEq ⟦Edwards25519_basePointPc.t⟧ᵣ :=
  Ty.decEqDenoteRaw _

/-- The initializer's literal: the points, `is_base` set at `1`, zero padding. -/
public theorem Edwards25519_basePointPc.lit_eq :
    Edwards25519_basePointPc.lit =
      Vector.ofFn fun i =>
        (Edwards25519.basePointPc.pts[i]).raw (Edwards25519.basePointPc.isBase i) := by
  decide +kernel

/-- The initializer's value: its literal. -/
public theorem Edwards25519_basePointPc.value_eq (s : GlobalState) :
    Edwards25519_basePointPc.value s = .value (Ty.wrap Edwards25519_basePointPc.lit, s) :=
  GlobalInitializer.compute_value _ _ ⟨_, by with_unfolding_all rfl⟩

/-- Entry `i`'s bits in the zero-padded table. -/
theorem basePointPc_entry_bits :
    ∀ i : Fin 16,
      (Ty.flatBits Edwards25519_basePointPc.lit (hw := width_basePointPc)).extractLsb'
          (1344 * i.val) 1344 =
        (Edwards25519.basePointPc.pts[i]).bits
          ((Edwards25519.basePointPc.isBase i).setWidth 64) := by
  decide +kernel

/-- Entry `i` of the table global's block (`step_addressof … value_eq`'s facts): its point,
`is_base` set at `1` alone. -/
public theorem _root_.LeanMLIR.RIR.MemoryState.readPt_basePointPc {m : MemoryState} {p : Pointer}
    {hw : Edwards25519_basePointPc.t.width = 21504} (i : Fin 16) (hf : Fits m p 21504)
    (ho : p.offset = 0)
    (hr : m.readAt p 21504 = Ty.flatBits Edwards25519_basePointPc.lit (hw := hw)) :
    m.PtFit (p.add (BitVec.ofNat 64 (168 * i.val))) ∧
      m.readPt (p.add (BitVec.ofNat 64 (168 * i.val))) = Edwards25519.basePointPc.pts[i] ∧
      m.readRest (p.add (BitVec.ofNat 64 (168 * i.val))) =
        (Edwards25519.basePointPc.isBase i).setWidth 64 := by
  replace hr :
    m.readAt p 21504 = Ty.flatBits Edwards25519_basePointPc.lit (hw := width_basePointPc) := hr
  replace ho : p.offset.toNat + 2688 ≤ 2 ^ 64 := by simp [ho]
  have hi := i.isLt
  have hn : (BitVec.ofNat 64 (168 * i.val)).toNat = 168 * i.val := by
    rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
  have hov : ¬p.offset.uaddOverflow (BitVec.ofNat 64 (168 * i.val)) := by
    simp only [BitVec.uaddOverflow, hn, decide_eq_true_eq, Nat.not_le]; omega
  have hwd : (BitVec.ofNat 64 (168 * i.val)).toNat * 8 + 1344 ≤ 21504 := by
    rw [hn]; omega
  have hq : m.PtFit (p.add (BitVec.ofNat 64 (168 * i.val))) := by
    refine ⟨?_, Fits.add_of_le hov hwd hf⟩
    simp only [Pointer.add, BitVec.toNat_add, hn]
    rw [Nat.mod_eq_of_lt (by omega)]; omega
  have h := MemoryState.readAt_add_of_readAt hf hov hwd hr
  rw [hn, show 168 * i.val * 8 = 1344 * i.val by omega, basePointPc_entry_bits] at h
  exact ⟨hq, MemoryState.readPt_of_readAt hq h⟩

/-- The table's limbs are below `2^52`. -/
public theorem Edwards25519.basePointPc.pts_lt (i : Fin 16) :
    (Edwards25519.basePointPc.pts[i]).Lt (2 ^ 52) := by
  revert i
  unfold ZPt.Lt Fe.Lt
  decide +kernel

