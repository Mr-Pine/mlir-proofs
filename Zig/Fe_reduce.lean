/-! ## Specification -/

@[expose] public section

/-- `limbs[i + 1] += limbs[i] >> 51; limbs[i] &= MASK51` for `i = 0 … 3`. -/
def Fe.reduce.carry (l : Fin 5 → BitVec 64) : Fin 5 → BitVec 64 :=
  let l1 := l 1 + (l 0 >>> 51)
  let l2 := l 2 + (l1 >>> 51)
  let l3 := l 3 + (l2 >>> 51)
  let l4 := l 4 + (l3 >>> 51)
  fun
  | ⟨0, _⟩ => l 0 &&& Fe.mask
  | ⟨1, _⟩ => l1 &&& Fe.mask
  | ⟨2, _⟩ => l2 &&& Fe.mask
  | ⟨3, _⟩ => l3 &&& Fe.mask
  | ⟨4, _⟩ => l4

/-- `limbs[0] += 19 * (limbs[4] >> 51); limbs[4] &= MASK51`. -/
def Fe.reduce.wrap (l : Fin 5 → BitVec 64) : Fin 5 → BitVec 64 := fun
  | ⟨0, _⟩ => l 0 + 19#64 * (l 4 >>> 51)
  | ⟨4, _⟩ => l 4 &&& Fe.mask
  | i => l i

/-- The canonical limbs, below `p`: two carry passes; `+ 19` and a third, so the top carry is
`1` exactly when the value is at least `p`; `+ 2^255 - 19`, and a last carry dropping `2^255`. -/
def Fe.reduce.spec (l : Fin 5 → BitVec 64) : Fin 5 → BitVec 64 :=
  let l := Fe.reduce.wrap (Fe.reduce.carry (Fe.reduce.wrap (Fe.reduce.carry l)))
  let l := fun i => if i = 0 then l 0 + 19#64 else l i
  let l := Fe.reduce.wrap (Fe.reduce.carry l)
  let l := fun i => if i = 0 then l 0 + 0x7ffffffffffed#64 else l i + 0x7ffffffffffff#64
  let l := Fe.reduce.carry l
  fun i => if i = 4 then l 4 &&& Fe.mask else l i

end

