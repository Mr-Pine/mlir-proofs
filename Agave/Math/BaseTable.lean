/-- Limb `k` of field `f` (`y + x`, `y - x`, `2d x y`) of serial entry `j`: the 8 bytes at
`120 j + 40 f + 8 k`. -/
def serialLimbs (j f : ℕ) : Fin 5 → BitVec 64 := fun k =>
  BitVec.ofNat 64 (serialNat >>> (8 * (120 * j + 40 * f + 8 * k)))

/-- AVX2 entry `j`: lane `l` of register `i` is the `u32` at `160 j + 32 i + 4 l`. -/
def avx2Entry (j : ℕ) : Fe2625x4 := fun i =>
  Vector.ofFn fun l : Fin 8 => BitVec.ofNat 32 (avx2Nat >>> (8 * (160 * j + 32 * i + 4 * l)))

/-- `B` in extended coordinates over `ℕ`. -/
def base : E :=
  ⟨BxN, ByN, BxN * ByN % p, 1⟩

/-- `(2 j + 1) B` in extended coordinates over `ℕ`: `B`, then `2 B` added `j` times. -/
def odd : ℕ → E
  | 0 => base
  | j + 1 => eadd (odd j) (eadd base base)

end BaseTable

