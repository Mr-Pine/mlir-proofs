/-! ## Checks

Natural number checks, mod `p`, that the kernel decides. -/

/-- `a ≡ b mod p`. -/
def eqP (a b : ℕ) : Bool :=
  a % p == b % p

/-- Serial entry `j` is the affine Niels form of `odd j = (X : Y : T : Z)`, multiplied by `Z`:
`(y + x) Z = 2 X + (y - x) Z`, `((y + x) + (y - x)) Z = 2 Y`, `2d x y Z = 2d T`; limbs below
`2^52`. -/
def serialOk (j : ℕ) : Bool :=
  let P := odd j
  let a := Limbs.nat (serialLimbs j 0)
  let b := Limbs.nat (serialLimbs j 1)
  let c := Limbs.nat (serialLimbs j 2)
  eqP (a * P.Z) (2 * P.X + b * P.Z) && eqP ((a + b) * P.Z) (2 * P.Y) && eqP (c * P.Z) (d2N * P.T) &&
    decide (∀ f < 3, ∀ k : Fin 5, (serialLimbs j f k).toNat < 2 ^ 52)

/-- Element `e`'s number, as `Fe2625x4.nat_eq` expands it. -/
def natE (v : Fe2625x4) (e : Fin 4) : ℕ :=
  (v 0)[Fe2625x4.evenLane e].toNat + (v 0)[Fe2625x4.oddLane e].toNat * 2 ^ 26 +
    (v 1)[Fe2625x4.evenLane e].toNat * 2 ^ 51 +
    (v 1)[Fe2625x4.oddLane e].toNat * 2 ^ 77 +
    (v 2)[Fe2625x4.evenLane e].toNat * 2 ^ 102 +
    (v 2)[Fe2625x4.oddLane e].toNat * 2 ^ 128 +
    (v 3)[Fe2625x4.evenLane e].toNat * 2 ^ 153 +
    (v 3)[Fe2625x4.oddLane e].toNat * 2 ^ 179 +
    (v 4)[Fe2625x4.evenLane e].toNat * 2 ^ 204 +
    (v 4)[Fe2625x4.oddLane e].toNat * 2 ^ 230

/-- AVX2 entry `j = (A, B, C, D)` is a cached form of `odd j = (X : Y : T : Z)`, multiplied by
`Z`: `B Z = X C + A Z`, `(B + A) Z = Y C`, `2 D Z = 2d T C`, `C ≠ 0`; even limbs below `2^26`, odd
ones below `2^25`. -/
def avx2Ok (j : ℕ) : Bool :=
  let P := odd j
  let v := avx2Entry j
  let A := natE v 0
  let B := natE v 1
  let C := natE v 2
  let D := natE v 3
  eqP (B * P.Z) (P.X * C + A * P.Z) && eqP ((B + A) * P.Z) (P.Y * C) &&
    eqP (2 * D * P.Z) (d2N * P.T * C) &&
    C % p != 0 &&
    decide
      (∀ (i : Fin 5) (e : Fin 4),
        (v i)[Fe2625x4.evenLane e].toNat < 2 ^ 26 ∧ (v i)[Fe2625x4.oddLane e].toNat < 2 ^ 25)

theorem serialOk_all : ∀ j < 64, serialOk j = true := by decide +kernel

theorem avx2Ok_all : ∀ j < 64, avx2Ok j = true := by decide +kernel

/-! ## Soundness -/

theorem natCast_eq {a b : ℕ} (h : eqP a b = true) : (a : ZMod p) = b :=
  (ZMod.natCast_eq_natCast_iff' a b p).2 (beq_iff_eq.1 h)

/-- `odd j` is `(2 j + 1) B`. -/
public theorem rep_odd (j : ℕ) : Rep ((2 * j + 1) • basePoint) (odd j) := by
  induction j with
  | zero => simpa [odd, base] using rep_B
  | succ j
    ih =>
    have e : (2 * (j + 1) + 1) • basePoint = (2 * j + 1) • basePoint + (basePoint + basePoint) := by
      rw [show 2 * (j + 1) + 1 = (2 * j + 1) + 2 by ring, add_smul, two_smul]
    rw [e]
    exact rep_add ih (rep_add rep_B rep_B)

/-- Serial entry `j < 64` is `(2 j + 1) B` as an `AffineNielsPoint`, its limbs below `2^52`. -/
public theorem serial_entry {j : ℕ} (hj : j < 64) :
    let P := (2 * j + 1) • basePoint
    IsAffineNiels P.x P.y (Limbs.val (serialLimbs j 0)) (Limbs.val (serialLimbs j 1))
        (Limbs.val (serialLimbs j 2)) ∧
      ∀ f < 3, ∀ k, (serialLimbs j f k).toNat < 2 ^ 52 := by
  intro P
  have h := serialOk_all j hj
  simp only [serialOk, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨e₁, e₂⟩, e₃⟩, hb⟩ := h
  refine ⟨?_, hb⟩
  have hR := rep_odd j
  have hT := IsExt.t_eq hR
  obtain ⟨hZ, hX, hY, -⟩ := hR
  have e₁ := natCast_eq e₁
  have e₂ := natCast_eq e₂
  have e₃ := natCast_eq e₃
  push_cast [cast_d2N] at e₁ e₂ e₃
  rw [Limbs.val_nat, Limbs.val_nat, Limbs.val_nat]
  rw [hX] at e₁
  rw [hY] at e₂
  rw [hT] at e₃
  generalize ((Limbs.nat (serialLimbs j 0) : ℕ) : ZMod p) = a at *
  generalize ((Limbs.nat (serialLimbs j 1) : ℕ) : ZMod p) = b at *
  generalize ((Limbs.nat (serialLimbs j 2) : ℕ) : ZMod p) = c at *
  have h₁ := mul_right_cancel₀ hZ (e₁.trans (by ring) : a * _ = (2 * P.x + b) * _)
  have h₂ := mul_right_cancel₀ hZ (e₂.trans (by ring) : (a + b) * _ = (2 * P.y) * _)
  have h₃ := mul_right_cancel₀ hZ (e₃.trans (by ring) : c * _ = (2 * d * P.x * P.y) * _)
  have h2 : (2 : ZMod p) ≠ 0 := by decide
  refine ⟨one_ne_zero, ?_, ?_, ?_⟩
  · exact mul_left_cancel₀ h2 (by linear_combination h₁ + h₂)
  · exact mul_left_cancel₀ h2 (by linear_combination h₂ - h₁)
  · linear_combination h₃

/-- AVX2 entry `j < 64` is `(2 j + 1) B` as a `CachedPoint`, its even limbs below `2^26` and odd
ones below `2^25`. -/
public theorem avx2_entry {j : ℕ} (hj : j < 64) :
    let P := (2 * j + 1) • basePoint
    let v := avx2Entry j
    IsCached P.x P.y (Fe2625x4.val v 0) (Fe2625x4.val v 1) (Fe2625x4.val v 2) (Fe2625x4.val v 3) ∧
      ∀ (i : Fin 5) (e : Fin 4),
        (v i)[Fe2625x4.evenLane e].toNat < 2 ^ 26 ∧ (v i)[Fe2625x4.oddLane e].toNat < 2 ^ 25 := by
  intro P v
  have h := avx2Ok_all j hj
  simp only [avx2Ok, Bool.and_eq_true, decide_eq_true_eq, bne_iff_ne, ne_eq] at h
  obtain ⟨⟨⟨⟨e₁, e₂⟩, e₃⟩, hC⟩, hb⟩ := h
  refine ⟨?_, hb⟩
  have hR := rep_odd j
  have hT := IsExt.t_eq hR
  obtain ⟨hZ, hX, hY, -⟩ := hR
  have e₁ := natCast_eq e₁
  have e₂ := natCast_eq e₂
  have e₃ := natCast_eq e₃
  push_cast [cast_d2N] at e₁ e₂ e₃
  have hn (e : Fin 4) : Fe2625x4.val v e = ((natE v e : ℕ) : ZMod p) := by
    rw [Fe2625x4.val, Fe2625x4.nat_eq]; rfl
  have hC' : ((natE v 2 : ℕ) : ZMod p) ≠ 0 := fun h0 =>
    hC ((ZMod.natCast_eq_natCast_iff' _ 0 p).1 (by rw [h0, Nat.cast_zero]))
  rw [hn, hn, hn, hn]
  generalize ((natE v 0 : ℕ) : ZMod p) = A at *
  generalize ((natE v 1 : ℕ) : ZMod p) = B at *
  generalize ((natE v 2 : ℕ) : ZMod p) = C at *
  generalize ((natE v 3 : ℕ) : ZMod p) = D at *
  rw [hX] at e₁
  rw [hY] at e₂
  rw [hT] at e₃
  have h₁ := mul_right_cancel₀ hZ (e₁.trans (by ring) : B * _ = (P.x * C + A) * _)
  have h₂ := mul_right_cancel₀ hZ (e₂.trans (by ring) : (B + A) * _ = (P.y * C) * _)
  have h₃ := mul_right_cancel₀ hZ (e₃.trans (by ring) : 2 * D * _ = (2 * d * P.x * P.y * C) * _)
  have h2 : (2 : ZMod p) ≠ 0 := by decide
  have hi : (2 : ZMod p) * 2⁻¹ = 1 := mul_inv_cancel₀ h2
  refine ⟨C * 2⁻¹, mul_ne_zero hC' (inv_ne_zero h2), ?_, ?_, ?_, ?_⟩
  · linear_combination (2 : ZMod p)⁻¹ * (h₂ - h₁) - A * hi
  · linear_combination (2 : ZMod p)⁻¹ * (h₁ + h₂) - B * hi
  · linear_combination (-C) * hi
  · linear_combination (2 : ZMod p)⁻¹ * h₃ - D * hi

end BaseTable

end MLIR.Agave
