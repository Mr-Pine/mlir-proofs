    Serial.anon_042b818bc72209407b52bd0e4d6c8368_73.lit =
      Vector.ofFn fun i => BitVec.ofNat 8 (serialNat >>> (8 * (i : ℕ))) := by
  unfold Serial.anon_042b818bc72209407b52bd0e4d6c8368_73.lit
  exact
    congrArg (fun N => Vector.ofFn fun i : Fin 7680 => BitVec.ofNat 8 (N >>> (8 * (i : ℕ))))
      (by decide +kernel : _ = serialNat)

public theorem avx2_lit :
    Avx2.BASEPOINT_ODD_LOOKUP_TABLE.lit =
      Vector.ofFn fun i => BitVec.ofNat 8 (avx2Nat >>> (8 * (i : ℕ))) := by
  unfold Avx2.BASEPOINT_ODD_LOOKUP_TABLE.lit
  exact
    congrArg (fun N => Vector.ofFn fun i : Fin 10240 => BitVec.ofNat 8 (N >>> (8 * (i : ℕ))))
      (by decide +kernel : _ = avx2Nat)

/-- Byte `k` of the serial table. -/
